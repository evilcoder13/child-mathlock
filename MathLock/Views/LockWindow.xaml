<Window x:Class="MathLock.Views.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MathLock"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowState="Maximized"
        Background="#0F172A">
    <Grid>
        <!-- Background Gradient Aura -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#1E293B" Offset="0"/>
                    <GradientStop Color="#090D16" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Hidden Corner Tap for Parent PIN (Top-Left 80x80 invisible area) -->
        <Border x:Name="HiddenCornerBorder"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="80" Height="80"
                Background="Transparent"
                Cursor="Hand"
                MouseLeftButtonDown="HiddenCornerBorder_MouseLeftButtonDown"/>

        <!-- Main Challenge Container -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="850">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header / Stars -->
                <RowDefinition Height="Auto"/> <!-- Timer Bar -->
                <RowDefinition Height="Auto"/> <!-- Question Card -->
                <RowDefinition Height="Auto"/> <!-- Feedback message / Streak -->
            </Grid.RowDefinitions>

            <!-- Top Header: Title and Star Progress Bar -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🚀 MathLock Challenge" FontSize="36" FontWeight="ExtraBold" Foreground="#38BDF8"/>
                </StackPanel>
                
                <TextBlock x:Name="TxtProgressDesc" Text="Solve 10 quick maths to unlock your computer!"
                           FontSize="18" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,16"/>

                <!-- Stars Row (10 stars) -->
                <ItemsControl x:Name="StarsItemsControl" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="6,0" Width="36" Height="36">
                                <TextBlock Text="{Binding StarGlyph}"
                                           FontSize="28"
                                           Foreground="{Binding StarColor}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Countdown Timer Bar (Anti-calculator mechanism) -->
            <Grid Grid.Row="1" Height="14" Margin="40,0,40,24">
                <Border CornerRadius="7" Background="#334155"/>
                <ProgressBar x:Name="TimerProgressBar" Height="14" Minimum="0" Maximum="100" Value="100"
                             Foreground="#F59E0B" Background="Transparent" BorderThickness="0"/>
            </Grid>

            <!-- Center Question Card -->
            <Border Grid.Row="2" CornerRadius="24" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="3" Padding="32">
                <StackPanel>
                    <!-- Question Prompt / Subtitle -->
                    <TextBlock x:Name="TxtPromptTitle" Text="Quick Mental Math"
                               FontSize="20" FontWeight="SemiBold" Foreground="#A5B4FC" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <!-- Visual Hint / Icons (for counting / number bonds) -->
                    <TextBlock x:Name="TxtVisualHint" Text=""
                               FontSize="32" Foreground="#FDE047" HorizontalAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,0,16"
                               Visibility="Collapsed"/>

                    <!-- Math Expression -->
                    <Border CornerRadius="16" Background="#0F172A" Padding="20,16" Margin="0,0,0,28" MinWidth="450" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtExpression" Text="12 + 15 = ?"
                                   FontSize="48" FontWeight="ExtraBold" Foreground="#F8FAFC"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Answer Options (4 Large Tactile Buttons) -->
                    <UniformGrid x:Name="ChoicesGrid" Columns="2" Rows="2" Margin="10,0">
                        <!-- Populated programmatically -->
                    </UniformGrid>

                    <!-- Quick Numpad Container (for direct input if preferred) -->
                    <StackPanel x:Name="DirectInputPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBox x:Name="TxtDirectAnswer" FontSize="28" Width="200" HorizontalContentAlignment="Center"
                                 Background="#0F172A" Foreground="White" BorderBrush="#3B82F6" KeyDown="TxtDirectAnswer_KeyDown"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Bottom Status / Streak Banner -->
            <StackPanel Grid.Row="3" Margin="0,20,0,0" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtFeedback" Text=""
                           FontSize="20" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                <TextBlock Text="💡 Tip: Solve mentally! Fast answers keep your streak burning 🔥"
                           FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>

    <Window.Resources>
        <Style x:Key="ChoiceButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="16" Background="{TemplateBinding Background}"
                                BorderBrush="#60A5FA" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
