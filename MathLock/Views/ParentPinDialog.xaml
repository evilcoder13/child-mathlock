<Window x:Class="MathLock.Views.ParentPinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parent Override"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Width="380" Height="440"
        Background="#1E293B"
        Topmost="True">
    <Border BorderBrush="#3B82F6" BorderThickness="3" CornerRadius="16">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="🛡️ Parent Override"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                <TextBlock Text="Enter Parent PIN to unlock or change settings"
                           FontSize="12" Foreground="#94A3B8"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- PIN Display Box -->
            <PasswordBox x:Name="TxtPin" Grid.Row="1"
                         Height="50" FontSize="28"
                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Background="#0F172A" Foreground="#F8FAFC"
                         BorderBrush="#475569" BorderThickness="2"
                         Margin="0,0,0,12" MaxLength="6"
                         PasswordChanged="TxtPin_PasswordChanged"/>

            <!-- Status / Error text -->
            <TextBlock x:Name="TxtError" Grid.Row="2"
                       Text="" Foreground="#EF4444" FontWeight="SemiBold"
                       FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <!-- On-screen Numpad for Touch / Mouse -->
            <UniformGrid Grid.Row="3" Columns="3" Margin="0,0,0,16">
                <Button Content="1" Style="{DynamicResource NumBtnStyle}" Click="NumBtn_Click"/>
                <Button Content="2" Style="{DynamicResource NumBtnStyle}" Click="NumBtn_Click"/>
                <Button Content="3" Style="{DynamicResource NumBtnStyle}" Click="NumBtn_Click"/>
                <Button Content="4" Style="{DynamicResource NumBtnStyle}" Click="NumBtn_Click"/>
                <Button Content="5" Style="{DynamicResource NumBtnStyle}" Click="NumBtn_Click"/>
                <Button Content="6" Style="{DynamicResource NumBtnStyle}" Click="NumBtn_Click"/>
                <Button Content="7" Style="{DynamicResource NumBtnStyle}" Click="NumBtn_Click"/>
                <Button Content="8" Style="{DynamicResource NumBtnStyle}" Click="NumBtn_Click"/>
                <Button Content="9" Style="{DynamicResource NumBtnStyle}" Click="NumBtn_Click"/>
                <Button Content="Clear" Style="{DynamicResource ActionBtnStyle}" Click="ClearBtn_Click"/>
                <Button Content="0" Style="{DynamicResource NumBtnStyle}" Click="NumBtn_Click"/>
                <Button Content="⌫" Style="{DynamicResource ActionBtnStyle}" Click="BackBtn_Click"/>
            </UniformGrid>

            <!-- Bottom Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnUnlock" Content="Unlock Computer" Width="150" Height="42"
                        Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="14"
                        Margin="0,0,10,0" Click="BtnUnlock_Click"/>
                <Button x:Name="BtnCancel" Content="Cancel" Width="100" Height="42"
                        Background="#475569" Foreground="White" FontWeight="SemiBold" FontSize="14"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>

    <Window.Resources>
        <Style x:Key="NumBtnStyle" TargetType="Button">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtnStyle" TargetType="Button" BasedOn="{StaticResource NumBtnStyle}">
            <Setter Property="Background" Value="#475569"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
</Window>
