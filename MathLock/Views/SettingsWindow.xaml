<Window x:Class="MathLock.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MathLock Settings (Parent Control)"
        WindowStartupLocation="CenterScreen"
        Width="520" Height="580"
        Background="#0F172A"
        Foreground="#F8FAFC">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title -->
                <RowDefinition Height="*"/>    <!-- Settings Form -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="⚙️ MathLock Configuration" FontSize="24" FontWeight="Bold" Foreground="#38BDF8"/>
                <TextBlock Text="Configure difficulty, time limits, auto-start, and parent PIN." FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Settings Fields -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Difficulty Level -->
                    <TextBlock Text="Target Math Difficulty:" FontWeight="SemiBold" FontSize="14" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbDifficulty" Height="36" FontSize="14" Margin="0,0,0,16">
                        <ComboBoxItem Content="Grade 1–2 (Addition &amp; Subtraction within 20)"/>
                        <ComboBoxItem Content="Grade 2–3 (Mental +, -, ×, ÷ within 100, comparisons, bonds)"/>
                        <ComboBoxItem Content="Grade 4–5 (Multi-digit, tables up to 12×12, multi-step)"/>
                    </ComboBox>

                    <!-- Number of Questions Required -->
                    <TextBlock Text="Questions Required to Unlock:" FontWeight="SemiBold" FontSize="14" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderQuestions" Minimum="3" Maximum="25" SmallChange="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding ElementName=SliderQuestions, Path=Value}"
                                   FontWeight="Bold" FontSize="16" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Anti-Calculator Timer Limit -->
                    <TextBlock Text="Anti-Calculator Speed Timer (Seconds per question):" FontWeight="SemiBold" FontSize="14" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                    <TextBlock Text="Shorter timers (e.g. 10-15s) prevent opening a phone or calculator app." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderTimer" Minimum="5" Maximum="30" SmallChange="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding ElementName=SliderTimer, Path=Value, StringFormat={}{0}s}"
                                   FontWeight="Bold" FontSize="16" Foreground="#F59E0B" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Enable Audio Chimes -->
                    <CheckBox x:Name="ChkSound" Content="Play kid-friendly cheerful sound effects"
                              FontSize="14" Foreground="#E2E8F0" Margin="0,0,0,16" IsChecked="True"/>

                    <!-- Change Parent PIN -->
                    <Border CornerRadius="8" Background="#1E293B" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Change Parent PIN:" FontWeight="Bold" FontSize="14" Foreground="#E2E8F0" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="New PIN (digits)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="TxtNewPin" Height="32" MaxLength="6" FontSize="16" Background="#0F172A" Foreground="White"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Confirm PIN" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="TxtConfirmPin" Height="32" MaxLength="6" FontSize="16" Background="#0F172A" Foreground="White"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Periodic 30-Minute Lock -->
                    <Border CornerRadius="8" Background="#1E293B" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="ChkPeriodicLock" Content="Enable Periodic Auto-Lock (e.g. every 30 minutes)"
                                      FontSize="14" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,0,0,8" IsChecked="True"/>
                            <TextBlock Text="Timer resets after each completed math challenge." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SliderInterval" Minimum="5" Maximum="120" SmallChange="5" IsSnapToTickEnabled="True" TickFrequency="5"
                                        VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ElementName=SliderInterval, Path=Value, StringFormat={}{0}m}"
                                           FontWeight="Bold" FontSize="16" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Windows Logon / Unlock Triggers -->
                    <Border CornerRadius="8" Background="#1E293B" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Windows Auto-Start &amp; Unlock Integration:" FontWeight="Bold" FontSize="14" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                            <TextBlock Text="Automatically launches in background on login, listens for PC unlock, and enforces 30' interval." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnRegisterTask" Content="Install &amp; Enable Auto-Start"
                                        Padding="10,6" Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                                        Click="BtnRegisterTask_Click" Margin="0,0,10,0"/>
                                <Button x:Name="BtnUnregisterTask" Content="Disable Auto-Start"
                                        Padding="10,6" Background="#475569" Foreground="White" FontWeight="SemiBold"
                                        Click="BtnUnregisterTask_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtTaskStatus" Text="" FontSize="12" Foreground="#10B981" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="BtnTestLock" Content="Test Math Lock Now"
                        Padding="14,8" Background="#F59E0B" Foreground="Black" FontWeight="Bold" Margin="0,0,10,0"
                        Click="BtnTestLock_Click"/>
                <Button x:Name="BtnSave" Content="Save Settings"
                        Padding="18,8" Background="#10B981" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"
                        Click="BtnSave_Click"/>
                <Button x:Name="BtnClose" Content="Close"
                        Padding="14,8" Background="#334155" Foreground="White"
                        Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
